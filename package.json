{
  "name": "container-os",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=20.0.0", "pnpm": ">=9.0.0" },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
