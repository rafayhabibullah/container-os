# ─── Node modules — always reinstalled inside the image ───────────────────────
node_modules
**/node_modules

# ─── Local build artefacts — rebuilt inside the image ─────────────────────────
**/.next
**/dist
**/build

# ─── pnpm store cache ─────────────────────────────────────────────────────────
.pnpm-store

# ─── Environment files — never bake secrets into images ───────────────────────
.env
.env.*
!.env.example

# ─── Version control ──────────────────────────────────────────────────────────
.git
.gitignore

# ─── Editor / OS artefacts ────────────────────────────────────────────────────
.DS_Store
.vscode
.idea
*.swp

# ─── Test output ──────────────────────────────────────────────────────────────
coverage
**/*.spec.ts
**/*.test.ts
**/vitest.config.ts

# ─── Docs & PDFs ──────────────────────────────────────────────────────────────
docs
README.md
*.pdf

# ─── Shell scripts (except the API entrypoint) ────────────────────────────────
*.sh
!apps/api/entrypoint.sh
