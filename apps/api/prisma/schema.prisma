  draft
  published
  paused
  fully_booked
  archived
}

enum BookingMode {
  approval_required
  instant_booking
  request_price
}

model Listing {
  id               String        @id @default(cuid())
  organisationId   String
  siteId           String
  unitId           String        @unique
  slug             String        @unique
  title            String
  description      String?
  publicPriceMinor Int?
  showPrice        Boolean       @default(true)
  depositMinor     Int?
  availableFrom    DateTime?
  bookingMode      BookingMode   @default(approval_required)
  status           ListingStatus @default(draft)
  requiredDocs     String[]      @default([])
  images           String[]      @default([])
  seoTitle         String?
  seoDescription   String?
  commissionRateBp Int           @default(0)
  source           String        @default("manual")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organisation     Organisation  @relation(fields: [organisationId], references: [id])
  site             Site          @relation(fields: [siteId], references: [id])
  unit             Unit          @relation(fields: [unitId], references: [id])
  marketplaceReviews MarketplaceReview[]
  marketplaceEvents  MarketplaceEvent[]

  @@index([organisationId, status])
  @@index([siteId, status])
}

model MarketplaceReview {
  id             String       @id @default(cuid())
  listingId      String
  organisationId String
  siteId         String
  rating         Int
  title          String?
  body           String?
  reviewerName   String?
  reviewerEmail  String?
  status         String       @default("published")
  source         String       @default("tenant")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  listing        Listing      @relation(fields: [listingId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  site           Site         @relation(fields: [siteId], references: [id])

  @@index([listingId, status])
  @@index([organisationId, status])
  @@index([siteId, status])
}

model SavedSearch {
  id        String   @id @default(cuid())
  email     String
  locale    String   @default("de")
  city      String?
  query     String?
  filters   Json
  status    String   @default("active")
  source    String   @default("marketplace")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, status])
  @@index([city, status])
}

model MarketplaceEvent {
  id             String        @id @default(cuid())
  listingId      String?
  organisationId String?
  siteId         String?
  eventType      String
  source         String        @default("web")
  sessionId      String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  listing        Listing?      @relation(fields: [listingId], references: [id])
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  site           Site?         @relation(fields: [siteId], references: [id])

  @@index([listingId, eventType, createdAt])
  @@index([organisationId, eventType, createdAt])
  @@index([siteId, eventType, createdAt])
}
